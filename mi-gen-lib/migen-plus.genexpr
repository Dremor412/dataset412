/****************************************************************/
/*  migen-plus : extensions de mi-gen pour gen~ (codebox)       */
/*                                                              */
/*  Meme format de donnees que migen-lib / migen-integrated :   */
/*    Data m(3)      un point : 0 = position, 1 = position      */
/*                   precedente, 2 = force accumulee            */
/*    Data m(3, N)   N points (structure integree)              */
/*  Ces fonctions se melangent donc librement avec celles de    */
/*  mi-gen dans le meme codebox.                                */
/*                                                              */
/*  Contenu :                                                   */
/*   - compute_bend_string : corde / barre avec vraie flexion   */
/*       (partiels etires comme un piano), modulation de        */
/*       tension (la note monte quand on joue fort), bouts      */
/*       fixes ou libres (xylophone)                            */
/*   - compute_plate : plaque (membrane avec epaisseur), gong   */
/*   - compute_modal + proxies modaux : un objet = une banque   */
/*       de resonateurs (synthese modale), stable a toutes les  */
/*       frequences et bien plus legere que des masses          */
/*   - compute_contact_hc : contact de Hunt-Crossley (choc      */
/*       realiste, sans saut de force au contact = sans clic)   */
/*   - compute_friction : frottement de Stribeck (archet)       */
/*                                                              */
/*  Unites : comme mi-gen, tout est "par echantillon" a 44,1 kHz;*/
/*  le code genere multiplie raideurs et amortissements par     */
/*  _Ksr / _Zsr pour rester juste a toute frequence.            */
/****************************************************************/

/* A charger apres migen-lib (et migen-integrated / migen-proxies : la
 * grille modale utilise get_mesh_linear_ponderation) :
 *   require("migen-plus"); */


/* ------------------------------------------------------------ */
/* Corde / barre avec flexion                                    */
/*                                                              */
/*  K    : tension (ressorts entre voisins)                     */
/*  Kb   : raideur de flexion. Energie = Kb/2 * somme des       */
/*         courbures^2 (courbure c_i = u_(i-1) - 2u_i + u_(i+1),  */
/*         nulle aux bouts). Donne la dispersion des vraies      */
/*         cordes : partiels de plus en plus aigus.             */
/*  Z    : amortissement entre voisins (eteint plus vite les    */
/*         aigus), Zo : frein vers le repos (eteint tout)       */
/*  tmod : modulation de tension (Kirchhoff-Carrier) : la       */
/*         tension augmente avec l'allongement moyen ; 0 = off  */
/*  libre: 0 = bouts fixes (corde), 1 = bouts libres (barre)    */
/*  Stabilite : K + 4 Kb < M                                    */
/* ------------------------------------------------------------ */

compute_bend_string(m_data, len, M, K, Kb, Z, Zo = 0, tmod = 0, libre = 0){

	invM = 1/M;
	A = 2 - Zo*invM;
	B = Zo*invM - 1;
	n = channels(m_data);

	// 1) les masses (les bouts restent en place si la corde est fixee)
	for(i = 0; i < n; i += 1){
		if((libre == 0) && ((i == 0) || (i == n-1))){
			poke(m_data, 0, 2, i);
		}
		else {
			x = peek(m_data, 0, i);
			xn = A*x + B*peek(m_data, 1, i) + peek(m_data, 2, i)*invM;
			poke(m_data, x, 1, i);
			poke(m_data, xn, 0, i);
			poke(m_data, 0, 2, i);
		}
	}

	// 2) modulation de tension : allongement moyen (pente au carre)
	Keff = K;
	if(tmod != 0){
		s = 0;
		for(i = 0; i < n-1; i += 1){
			d = peek(m_data, 0, i+1) - peek(m_data, 0, i);
			s += d*d;
		}
		Keff = K + tmod*s/(n-1);
	}

	// 3) tension + amortissement entre voisins
	for(i = 0; i < n-1; i += 1){
		x1 = peek(m_data, 0, i);
		x1r = peek(m_data, 1, i);
		x2 = peek(m_data, 0, i+1);
		x2r = peek(m_data, 1, i+1);
		f = Keff*(x1 - x2) + Z*((x1 - x1r) - (x2 - x2r));
		poke(m_data, peek(m_data, 2, i) - f, 2, i);
		poke(m_data, peek(m_data, 2, i+1) + f, 2, i+1);
	}

	// 4) flexion : chaque courbure interieure pousse son point et ses voisins
	if(Kb != 0){
		for(i = 1; i < n-1; i += 1){
			c = peek(m_data, 0, i-1) - 2*peek(m_data, 0, i) + peek(m_data, 0, i+1);
			poke(m_data, peek(m_data, 2, i) + 2*Kb*c, 2, i);
			poke(m_data, peek(m_data, 2, i-1) - Kb*c, 2, i-1);
			poke(m_data, peek(m_data, 2, i+1) - Kb*c, 2, i+1);
		}
	}
	return Keff;
}


/* ------------------------------------------------------------ */
/* Plaque (membrane avec epaisseur)                              */
/*                                                              */
/*  Grille nx * ny (indice i*ny + j, comme les mesh de mi-gen). */
/*  K : tension de membrane, Kb : flexion (epaisseur^2),        */
/*  tmod : modulation de tension (gong, cymbale : la note       */
/*  glisse vers le grave en s'eteignant), bords : 0 = libres,   */
/*  1 = fixes, 2 = tenue au centre (gong suspendu).             */
/*  Stabilite : 2 K + 16 Kb < M                                 */
/* ------------------------------------------------------------ */

compute_plate(m_data, length, width, M, K, Kb, Z, Zo = 0, tmod = 0, bords = 0){

	invM = 1/M;
	A = 2 - Zo*invM;
	B = Zo*invM - 1;
	centre = floor(length/2)*width + floor(width/2);

	for(i = 0; i < length; i += 1){
		for(j = 0; j < width; j += 1){
			idx = i*width + j;
			fixe = 0;
			if(bords == 1){
				if((i == 0) || (i == length-1) || (j == 0) || (j == width-1)) fixe = 1;
			}
			else if(bords == 2){
				if(idx == centre) fixe = 1;
			}
			if(fixe == 1){
				poke(m_data, 0, 2, idx);
			}
			else {
				x = peek(m_data, 0, idx);
				xn = A*x + B*peek(m_data, 1, idx) + peek(m_data, 2, idx)*invM;
				poke(m_data, x, 1, idx);
				poke(m_data, xn, 0, idx);
				poke(m_data, 0, 2, idx);
			}
		}
	}

	Keff = K;
	if(tmod != 0){
		s = 0;
		for(i = 0; i < length; i += 1){
			for(j = 0; j < width-1; j += 1){
				d = peek(m_data, 0, i*width + j + 1) - peek(m_data, 0, i*width + j);
				s += d*d;
			}
		}
		for(i = 0; i < length-1; i += 1){
			for(j = 0; j < width; j += 1){
				d = peek(m_data, 0, (i+1)*width + j) - peek(m_data, 0, i*width + j);
				s += d*d;
			}
		}
		Keff = K + tmod*s/(length*width);
	}

	// tension + amortissement, selon les deux axes
	for(i = 0; i < length; i += 1){
		for(j = 0; j < width-1; j += 1){
			idx = i*width + j;
			idx2 = idx + 1;
			x1 = peek(m_data, 0, idx);
			x1r = peek(m_data, 1, idx);
			x2 = peek(m_data, 0, idx2);
			x2r = peek(m_data, 1, idx2);
			f = Keff*(x1 - x2) + Z*((x1 - x1r) - (x2 - x2r));
			poke(m_data, peek(m_data, 2, idx) - f, 2, idx);
			poke(m_data, peek(m_data, 2, idx2) + f, 2, idx2);
		}
	}
	for(i = 0; i < length-1; i += 1){
		for(j = 0; j < width; j += 1){
			idx = i*width + j;
			idx2 = idx + width;
			x1 = peek(m_data, 0, idx);
			x1r = peek(m_data, 1, idx);
			x2 = peek(m_data, 0, idx2);
			x2r = peek(m_data, 1, idx2);
			f = Keff*(x1 - x2) + Z*((x1 - x1r) - (x2 - x2r));
			poke(m_data, peek(m_data, 2, idx) - f, 2, idx);
			poke(m_data, peek(m_data, 2, idx2) + f, 2, idx2);
		}
	}

	// flexion : laplacien (courbure) aux points interieurs
	if(Kb != 0){
		for(i = 1; i < length-1; i += 1){
			for(j = 1; j < width-1; j += 1){
				idx = i*width + j;
				c = peek(m_data, 0, idx-1) + peek(m_data, 0, idx+1)
				  + peek(m_data, 0, idx-width) + peek(m_data, 0, idx+width)
				  - 4*peek(m_data, 0, idx);
				poke(m_data, peek(m_data, 2, idx) + 4*Kb*c, 2, idx);
				poke(m_data, peek(m_data, 2, idx-1) - Kb*c, 2, idx-1);
				poke(m_data, peek(m_data, 2, idx+1) - Kb*c, 2, idx+1);
				poke(m_data, peek(m_data, 2, idx-width) - Kb*c, 2, idx-width);
				poke(m_data, peek(m_data, 2, idx+width) - Kb*c, 2, idx+width);
			}
		}
	}
	return Keff;
}


/* ------------------------------------------------------------ */
/* Objet modal (synthese modale)                                 */
/*                                                              */
/*  Un objet lineaire (corde, cloche, objet 3D importe...) se   */
/*  decompose en modes : chacun vibre seul a sa frequence et    */
/*  s'eteint a son rythme. On ne calcule que ces modes : stable */
/*  a toutes les frequences, et quelques dizaines de modes      */
/*  remplacent des centaines de masses et de ressorts.          */
/*                                                              */
/*  Data modes(8, nModes) :                                     */
/*    0 q   1 q precedent   2 force   3 pulsation de base (rad  */
/*    par echantillon a 44,1 kHz)   4 reserve   5 A   6 B       */
/*    7 cache des reglages (canal 0..3)                         */
/*  Data formes(P, nModes) : deformee de chaque mode aux P      */
/*  points ou l'on frappe / ecoute (modes normalises en masse). */
/*                                                              */
/*  hauteur : multiplie toutes les frequences (1 = d'origine)   */
/*  t60     : duree d'extinction du mode le plus grave (s)      */
/*  brillance : 0 = tous les modes durent pareil, 1 = un mode   */
/*              deux fois plus aigu s'eteint deux fois plus vite*/
/* ------------------------------------------------------------ */

compute_modal(m_modes, nModes, hauteur, t60, brillance){

	// coefficients recalcules seulement quand un reglage change
	if((peek(m_modes, 7, 0) != hauteur) || (peek(m_modes, 7, 1) != t60)
	   || (peek(m_modes, 7, 2) != brillance) || (peek(m_modes, 7, 3) == 0)){
		w1 = peek(m_modes, 3, 0) * hauteur;
		for(k = 0; k < nModes; k += 1){
			w = peek(m_modes, 3, k) * hauteur;
			r = 0;
			if(w < 3.1){
				sig = 6.91 / (max(t60, 0.001) * SAMPLERATE);
				sig = sig * (1 + brillance * (w / max(w1, 1e-9) - 1));
				r = exp(-sig);
			}
			poke(m_modes, 2*r*cos(w), 5, k);
			poke(m_modes, -r*r, 6, k);
		}
		poke(m_modes, hauteur, 7, 0);
		poke(m_modes, t60, 7, 1);
		poke(m_modes, brillance, 7, 2);
		poke(m_modes, 1, 7, 3);
	}

	for(k = 0; k < nModes; k += 1){
		q = peek(m_modes, 0, k);
		qn = peek(m_modes, 5, k)*q + peek(m_modes, 6, k)*peek(m_modes, 1, k) + peek(m_modes, 2, k);
		poke(m_modes, q, 1, k);
		poke(m_modes, qn, 0, k);
		poke(m_modes, 0, 2, k);
	}
	return 0;
}

/* position d'un point de l'objet modal = somme des modes ponderee */
set_proxy_pos_modal(proxy_data, m_modes, m_formes, p){
	poke(proxy_data, peek(proxy_data, 0), 1);
	s = 0;
	for(k = 0; k < channels(m_modes); k += 1){
		s += peek(m_formes, p, k) * peek(m_modes, 0, k);
	}
	poke(proxy_data, s, 0);
	return s;
}

/* une force sur un point se repartit sur les modes selon leur deformee */
apply_proxy_frc_modal(proxy_data, m_modes, m_formes, p){
	f = peek(proxy_data, 2);
	for(k = 0; k < channels(m_modes); k += 1){
		poke(m_modes, peek(m_modes, 2, k) + f*peek(m_formes, p, k), 2, k);
	}
	poke(proxy_data, 0, 2);
	return 0;
}


/* Corde / barre modale : point mobile val (0..1) entre deux lignes de
 * formes (une ligne par point de la structure d'origine), comme
 * set_proxy_pos_string. */
set_proxy_pos_modal_corde(proxy_data, m_modes, m_formes, val){
	poke(proxy_data, peek(proxy_data, 0), 1);
	np = dim(m_formes) - 1;
	pt = clamp(val, 0, 1) * np;
	p1 = clamp(floor(pt), 0, np);
	p2 = clamp(p1 + 1, 0, np);
	a = pt - p1;
	s = 0;
	for(k = 0; k < channels(m_modes); k += 1){
		s += ((1-a)*peek(m_formes, p1, k) + a*peek(m_formes, p2, k)) * peek(m_modes, 0, k);
	}
	poke(proxy_data, s, 0);
	return s;
}

apply_proxy_frc_modal_corde(proxy_data, m_modes, m_formes, val){
	np = dim(m_formes) - 1;
	pt = clamp(val, 0, 1) * np;
	p1 = clamp(floor(pt), 0, np);
	p2 = clamp(p1 + 1, 0, np);
	a = pt - p1;
	f = peek(proxy_data, 2);
	for(k = 0; k < channels(m_modes); k += 1){
		w = (1-a)*peek(m_formes, p1, k) + a*peek(m_formes, p2, k);
		poke(m_modes, peek(m_modes, 2, k) + f*w, 2, k);
	}
	poke(proxy_data, 0, 2);
	return 0;
}

/* Plaque / membrane modale : point (valL, valW) interpole entre quatre
 * lignes de formes (grille length x width), comme set_proxy_pos_mesh. */
set_proxy_pos_modal_grille(proxy_data, m_modes, m_formes, length, width, valL, valW){
	poke(proxy_data, peek(proxy_data, 0), 1);
	r1, c1, r2, c2, r3, c3, r4, c4 = get_mesh_linear_ponderation(m_formes, length, width, valL, valW);
	s = 0;
	for(k = 0; k < channels(m_modes); k += 1){
		w = c1*peek(m_formes, r1, k) + c2*peek(m_formes, r2, k) + c3*peek(m_formes, r3, k) + c4*peek(m_formes, r4, k);
		s += w * peek(m_modes, 0, k);
	}
	poke(proxy_data, s, 0);
	return s;
}

apply_proxy_frc_modal_grille(proxy_data, m_modes, m_formes, length, width, valL, valW){
	r1, c1, r2, c2, r3, c3, r4, c4 = get_mesh_linear_ponderation(m_formes, length, width, valL, valW);
	f = peek(proxy_data, 2);
	for(k = 0; k < channels(m_modes); k += 1){
		w = c1*peek(m_formes, r1, k) + c2*peek(m_formes, r2, k) + c3*peek(m_formes, r3, k) + c4*peek(m_formes, r4, k);
		poke(m_modes, peek(m_modes, 2, k) + f*w, 2, k);
	}
	poke(proxy_data, 0, 2);
	return 0;
}


/* ------------------------------------------------------------ */
/* Contact de Hunt-Crossley                                      */
/*                                                              */
/*  F = d^alpha * (K + Z * v) quand les deux points se touchent */
/*  (d = penetration, v = vitesse de penetration), jamais       */
/*  negative (pas de colle). La force part de 0 au contact :    */
/*  pas de saut, donc pas de clic.                              */
/*  alpha : 1 = lineaire, 1.5 = bille (Hertz), 2-3 = feutre de  */
/*  marteau de piano (plus on frappe fort, plus c'est brillant) */
/*  Meme convention de seuil que le contact de mi-gen.          */
/* ------------------------------------------------------------ */

compute_contact_hc(m1_data, m2_data, K, alpha, Z, thresh = 0){
	x1 = peek(m1_data, 0);
	x1r = peek(m1_data, 1);
	x2 = peek(m2_data, 0);
	x2r = peek(m2_data, 1);
	d = x1 - x2 + thresh;
	f = 0;
	if(d > 0){
		dp = pow(d, alpha);
		f = dp*(K + Z*((x1 - x1r) - (x2 - x2r)));
		if(f < 0) f = 0;
	}
	poke(m1_data, peek(m1_data, 2) - f, 2);
	poke(m2_data, peek(m2_data, 2) + f, 2);
	return f;
}


/* ------------------------------------------------------------ */
/* Frottement de Stribeck (archet, doigt mouille sur un verre)   */
/*                                                              */
/*  F = Fn * mu(v) * tanh(v / ve)                               */
/*  mu(v) = mud + (mus - mud) * exp(-|v| / vs)                  */
/*  Fn : pression (force normale), mus / mud : frottement       */
/*  statique / dynamique (mus > mud : accroche-glisse), vs :    */
/*  vitesse de Stribeck, ve : largeur de la zone d'accroche.    */
/* ------------------------------------------------------------ */

compute_friction(m1_data, m2_data, Fn, mus, mud, vs, ve){
	v = (peek(m1_data, 0) - peek(m1_data, 1)) - (peek(m2_data, 0) - peek(m2_data, 1));
	mu = mud + (mus - mud)*exp(-abs(v)/max(vs, 1e-12));
	f = Fn*mu*tanh(v/max(ve, 1e-12));
	poke(m1_data, peek(m1_data, 2) - f, 2);
	poke(m2_data, peek(m2_data, 2) + f, 2);
	return f;
}
